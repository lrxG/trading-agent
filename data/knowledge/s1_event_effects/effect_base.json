  "funnel": "455,146 条公告 → 78,928 事件包 → 61,980 可用（剔 T+20 窗口不完整者；evt_report.md 口径）",
  "funnel_vs_table_note": "§3 匹配对照表 32 类 n 合计 = 45,963 ≠ 61,980：61,980 是全部事件包（含中性/未归类类）；45,963 是进入分档匹配对照的 32 类子集（同档无事件对照不足者剔除）。两类口径并存，categories.n 加总只会等于 45,963，不得与 funnel 混读",
  "significance": "*** t≥2.6 | ** t≥2.0 | * t≥1.65（双侧近似）",
  "transcribed": "本表逐条数字转录自 matched_table §3，未做任何改写；strength 分数禁止手抄，由 s1.py 按 strength_rule 现场重算",
  "audit_20261009": "机器逐项对照 32/32 类 × 4 字段（n/event_fut20/net_effect/control）零误差；direction_prior 32/32 与 evt_taxonomy.CAT_MAP 一致；月度翻转 31/29 与 evt_robust_report.md §B 实测行数一致（实测报告 L292 的『32 中 30』为旧包文档自身笔误，以 robust §B 数据文件为准）"
 },
 "benchmark": {
  "event_base_rate_pct": 0.36,
  "note": "公告股 vs 无公告股自带 +0.36% 正漂移（32 类中 21 类净效应为正）——一切净效应必须相对该基准读，不能相对 0",
  "benchmark_method": "等权均值（禁中位数：收益右偏会造 +0.302%/日 假超额，曾令 31 类全『利好』通过自检）",
  "ar_definition": "AR = 个股日涨幅 − 全市场等权均值；CAR(k) = Σ AR over [T0, T0+k)，累加",
  "window": "T+20 为主窗（T0 = 公告日 D 之后首个交易日；仅窗口完整时计入）",
  "universe_rule": "基准 universe 必须与采样 universe 一致（混入新股曾造 −0.4% 假负）"
 },
 "n_min_trust": 30,
