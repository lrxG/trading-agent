 "coverage": {
  "taxonomy_classes": "evt_taxonomy.CAT_MAP 非中性映射目标 = 35 类 + KW 兜底独有『立案调查』= 36 类",
  "matched_table_classes": "本表 32 类 = 实测中进入匹配对照分析的类",
  "no_matched_rows": [
   "控制权变更",
   "高管变更",
   "业绩说明会"
  ],
  "no_matched_rows_note": "3 类在 CAT_MAP 有映射、evt_report.md 有实测行（控制权变更 n=61、高管变更 n=50）但不在 §3 匹配对照表（分档对照样本不足未列入）——运行时归类到这 3 类 → historical_effect=NO_RECORD → strength 恒 UNKNOWN，安全降级不编造",
  "benchmark_count_note": "『32 类中 21 类净效应为正』的 32 指本表类数；旧包文档多处混用 31/32（31 为早期分类版口径），数字引用以本表与 robust §B 数据文件为准"
 },
 "strength_rule": {
  "formula": "dev = |net_effect_20d − 0.36|；dev>=2.5 → 4 | 1.0<=dev<2.5 → 3 | 0.4<=dev<1.0 → 2 | dev<0.4 → 1；n<100 封顶 3",
  "mapping": {
   "4": "强",
   "3": "中",
   "2": "弱",
   "1": "微"
  },
  "grade_source": "旧包 EV_CAT_BASE 推导口径（|净效应 − +0.36% 基准|），由脚本推导、禁止手抄",
  "semantics": "strength = 历史实证催化强度档位（与净效应符号无关，符号看 net_effect_20d）；confidence = 本次归类/匹配/判断可信度，两者分开"
 },
 "evidence_grade_rule": {
  "A": "n >= 1000（大样本，结论最稳）",
  "B": "300 <= n < 1000",
  "C": "30 <= n < 300（可信但薄，禁单独下注）",
  "D": "n < 30（不达 n_min_trust，只报 INSUFFICIENT_SAMPLES）"
 },
